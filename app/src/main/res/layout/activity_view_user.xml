<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#F0F0F0"
  tools:context=".ViewUserActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Card chính chứa thông tin user -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@android:color/white"
      android:padding="20dp">

      <!-- Phần trên: Username + ID bên trái, Avatar bên phải -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <!-- Username + ID -->
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="12dp">

          <TextView
            android:id="@+id/tv_detail_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121" />

          <TextView
            android:id="@+id/tv_detail_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Avatar bo góc -->
        <ImageView
          android:id="@+id/iv_detail_avatar"
          android:layout_width="100dp"
          android:layout_height="100dp"
          tools:srcCompat="@tools:sample/avatars" />

      </LinearLayout>

      <!-- Phần dưới: Email, Tel, Description, Hobby -->
      <TextView
        android:id="@+id/tv_detail_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:textSize="16sp"
        android:textColor="#212121"
        android:layout_marginBottom="10dp" />

      <TextView
        android:id="@+id/tv_detail_tel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tel:"
        android:textSize="16sp"
        android:textColor="#212121"
        android:layout_marginBottom="10dp" />

      <TextView
        android:id="@+id/tv_detail_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description:"
        android:textSize="16sp"
        android:textColor="#212121"
        android:layout_marginBottom="10dp" />

      <TextView
        android:id="@+id/tv_detail_hobby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hobby:"
        android:textSize="16sp"
        android:textColor="#212121" />

    </LinearLayout>

  </LinearLayout>

</ScrollView>
